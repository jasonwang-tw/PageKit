{
  "manifest_version": 3,
  "name": "頁匣 PageKit",
  "short_name": "PageKit",
  "version": "1.17.2",
  "description": "頁匣 PageKit：瀏覽器效率工具箱，提供即時翻譯、截圖標註、圖片文字辨識與複製。",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://translate.google.com/*"
  ],
  "optional_permissions": ["desktopCapture"],
  "optional_host_permissions": [
    "https://paddle-model-ecology.bj.bcebos.com/*",
    "https://huggingface.co/*",
    "https://us.aws.cdn.hf.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "頁匣 PageKit｜選取文字翻譯；未選取時框選截圖",
    "default_icon": {
      "16": "icons/pagekit-16.png",
      "32": "icons/pagekit-32.png",
      "48": "icons/pagekit-48.png",
      "128": "icons/pagekit-128.png"
    }
  },
  "icons": {
    "16": "icons/pagekit-16.png",
    "32": "icons/pagekit-32.png",
    "48": "icons/pagekit-48.png",
    "128": "icons/pagekit-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/translate-popup.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/ocr-target.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://translate.google.com https://paddle-model-ecology.bj.bcebos.com https://huggingface.co https://us.aws.cdn.hf.co"
  },
  "commands": {
    "capture-region": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "網頁框選截圖與標註／OCR"
    },
    "capture-desktop": {
      "description": "桌面／應用程式截圖與標註／OCR",
      "global": true
    }
  }
}
